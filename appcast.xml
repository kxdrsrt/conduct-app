        <!--
            To publish a new release:
            1. Build the universal .app:
                 make clean then make build-universal SWIFT_DEBUG_FLAGS=
            2. Zip it (signature is over the bytes, so the name is interchangeable):
                 ditto -c -k (keepParent) build/Conduct.app build/Conduct-vX.Y.Z.zip
            3. Sign the zip with your EdDSA private key (read from the Keychain):
                 ./Frameworks/bin/sign_update build/Conduct-vX.Y.Z.zip
            4. Copy the output (edSignature + length) into the <enclosure> below
            5. Update version, url, and release notes
            6. Commit and push
        -->
        <item>
            <title>Version 1.0.0</title>
            <pubDate>Sat, 21 Jun 2026 00:00:00 +0000</pubDate>
